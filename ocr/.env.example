# Environment variables for MediKiosk OCR Engine
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is excluded by .gitignore

# Google Gemini API key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: Override the primary Gemini model (defaults to gemini-3.5-flash-lite)
# The service automatically falls back through alternative models on failure.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional: Rate limiting — max requests per client IP per minute (default 20)
RATE_LIMIT_PER_MINUTE=20

# Optional: Allowed CORS origins (comma-separated).
# Defaults to local loopback origins for development:
#   http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
#
# Production Configuration:
# In production, set this explicitly to your hospital kiosk frontend domain:
#   ALLOWED_ORIGINS="https://kiosk.your-hospital.in,https://app.your-hospital.in"
#
# SECURITY & COMPLIANCE NOTICE:
# CORS is a browser-enforced origin boundary, NOT an authentication or authorization mechanism.
# Production hospital deployment requires:
#  1. Upstream authentication & access controls (API gateway, mTLS, or OAuth2/bearer tokens).
#  2. Network isolation (dedicated internal VLAN, loopback proxying, no public internet exposure).
#  3. Formal medical data privacy review (HIPAA / DISHA / DPDP Act compliance).
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
