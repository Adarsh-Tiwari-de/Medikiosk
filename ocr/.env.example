# Environment variables for MediKiosk OCR Engine
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is excluded by .gitignore

# Google Gemini API key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: Override the primary Gemini model (defaults to gemini-3.5-flash-lite)
# The service automatically falls back through alternative models on failure.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional: Rate limiting — max requests per client IP per minute (default 20)
RATE_LIMIT_PER_MINUTE=20

# Optional: Allowed CORS origins (comma-separated). Defaults to * for local dev.
# In production, set this to your kiosk frontend origin, e.g.:
# ALLOWED_ORIGINS="https://medikiosk.your-hospital.in"
ALLOWED_ORIGINS="*"
